# --- Backend API ---------------------------------------------------------------
# The FastAPI service. Server Components read API_URL; any client code reads the
# NEXT_PUBLIC_ one. Point both at the same origin (no trailing slash).
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Site ---------------------------------------------------------------------
# Public origin of this deployment, used for absolute metadata URLs. Optional
# locally; set it in production (e.g. https://mlbplayoffs2026.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Revalidation webhook ---------------------------------------------------
# Shared secret for POST /api/revalidate. The pipeline sends this after each run
# so the live board and scorecard refresh immediately. Must match the pipeline's
# MLBSIM_REVALIDATE_SECRET (the pipeline also needs MLBSIM_WEB_REVALIDATE_URL set
# to https://<this-site>/api/revalidate).
REVALIDATE_SECRET=change-me
