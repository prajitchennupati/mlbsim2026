# Copy to .env and adjust. All variables are prefixed MLBSIM_ and read via
# mlbsim_core.config.Settings. Do not commit .env.

MLBSIM_ENVIRONMENT=local
MLBSIM_LOG_LEVEL=INFO
MLBSIM_LOG_JSON=false

# Local docker-compose defaults:
MLBSIM_DATABASE_URL=postgresql+psycopg://mlbsim:mlbsim@localhost:5432/mlbsim
MLBSIM_REDIS_URL=redis://localhost:6379/0

# For deployment, point these at Supabase / Render add-ons instead.
# MLBSIM_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
# MLBSIM_REDIS_URL=redis://HOST:6379/0

MLBSIM_DATA_DIR=./data
MLBSIM_HTTP_TIMEOUT_SECONDS=30
MLBSIM_HTTP_MAX_RETRIES=4
